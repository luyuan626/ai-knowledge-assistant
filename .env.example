# Optional: configure an OpenAI-compatible model endpoint. Keep actual secrets only in .env.
# DeepSeek example: https://api.deepseek.com + deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Hybrid RAG: SQLite stores source metadata; Milvus Lite stores BGE-M3 vectors.
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_DEVICE=cuda
# Omit MILVUS_URI to use the project-default persistent data/milvus.db path.
# MILVUS_URI=/absolute/path/to/milvus.db
MILVUS_COLLECTION=knowledge_chunks
RECALL_CANDIDATES=20

# Use an actually validated Ultralytics .pt model. Keep weights outside Git.
YOLO_MODEL_PATH=
YOLO_DEVICE=0
DATABASE_PATH=data/assistant.db
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173
